# Backend/proxy de mercado usado pelo APK.
# Exemplo: https://seu-dominio.com
EXPO_PUBLIC_MARKET_API_URL=

# Somente no servidor. Nao coloque BRAPI_TOKEN no app publico.
BRAPI_TOKEN=

# AdMob: IDs publicos. Troque os IDs de teste pelos IDs reais antes de monetizar.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID=ca-app-pub-3940256099942544/6300978111
EXPO_PUBLIC_ENABLE_ADS=1

# Google OAuth para conectar a conta Google e enviar backup ao Drive.
# Crie no Google Cloud e coloque tambem nas variaveis do EAS antes de gerar o APK.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
